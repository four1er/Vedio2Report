{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vedio2report",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTICLES",
        "class_name": "ArticleSession"
      },
      {
        "name": "CAPTION_CACHE",
        "class_name": "CaptionCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ArticleSession"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "CaptionCache"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "GENERATION_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "CAPTION_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "GEMINI_API_KEY"
    ]
  }
}
